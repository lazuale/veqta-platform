# Серверный DEV. Генератор scripts/create_config.py вставляет случайные секреты.
VEQTA_ENV=dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=test.platform.veqta.ru,localhost,127.0.0.1
DJANGO_TRUST_PROXY=1
DJANGO_CSRF_TRUSTED_ORIGINS=https://test.platform.veqta.ru
DJANGO_SECURE_COOKIES=1
DJANGO_STATIC_ROOT=/var/www/veqta/dev-static
DB_NAME=veqta_dev
DB_USER=veqta_dev
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
