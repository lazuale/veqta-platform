# Серверный DEV. Генератор scripts/create_config.py вставляет случайные секреты.
VEQTA_ENV=dev
VEQTA_HOSTNAME=__HOSTNAME__
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=__HOSTNAME__,localhost,127.0.0.1
DJANGO_TRUST_PROXY=1
DJANGO_CSRF_TRUSTED_ORIGINS=https://__HOSTNAME__
DJANGO_SECURE_COOKIES=1
DJANGO_STATIC_ROOT=/var/www/veqta/dev-static
DB_NAME=veqta_dev
DB_USER=svc_platform_dev
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
