# Серверный PROD. Генератор scripts/create_config.py вставляет случайные секреты.
VEQTA_ENV=prod
VEQTA_HOSTNAME=__HOSTNAME__
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=__HOSTNAME__
DJANGO_TRUST_PROXY=1
DJANGO_CSRF_TRUSTED_ORIGINS=https://__HOSTNAME__
DJANGO_SECURE_COOKIES=1
DJANGO_STATIC_ROOT=/var/www/veqta/prod-static
DB_NAME=veqta_prod
DB_USER=veqta_prod
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
