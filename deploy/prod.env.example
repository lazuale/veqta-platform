# Укажите свой домен; реальные секреты не храните в репозитории.
VEQTA_ENV=prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=portal.example.org
DJANGO_TRUST_PROXY=1
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.org
DJANGO_STATIC_ROOT=/var/www/veqta/static
DB_NAME=veqta_prod
DB_USER=veqta_prod
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
