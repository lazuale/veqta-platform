[Unit]
Description=VEQTA Platform DEV
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=veqta-dev
Group=veqta-dev
WorkingDirectory=/opt/veqta-dev
EnvironmentFile=/etc/veqta/dev.env
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=DJANGO_SETTINGS_MODULE PYTHONPATH PYTHONHOME DB_MIGRATION_PASSWORD
ExecStart=/opt/veqta-dev/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8767 --workers 2 --timeout 120 --error-logfile - --no-control-socket
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
